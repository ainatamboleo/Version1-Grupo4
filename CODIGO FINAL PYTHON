import matplotlib.pyplot as plt
import random
import serial
import threading

device = 'COM3'
mySerial = serial.Serial(device, 9600)
def grafica():
    plt.axis([0, 100, 0, 100])
    temperaturas = []  # Debe ser una lista para almacenar los valores históricos
    humedad = []
    eje_x = []
    i = 0

    # Activamos el modo interactivo de matplotlib fuera del bucle
    plt.ion()

    while i < 100:
        # Leemos la línea del puerto serie
        linea = mySerial.readline().decode('utf-8').rstrip()

        
        if linea:  
        
                
                trozos = linea.split(':')
                
                # Extraemos la temperatura 
                temp_valor = float(trozos[1])
                
                # Guardamos los datos en las listas
                eje_x.append(i)
                temperaturas.append(temp_valor)

                #Humedad
                                
                # Extraemos la temperatura 
                hum_valor = float(trozos[3])
                                
                                # Guardamos los datos en las listas
                humedad.append(hum_valor)
                
                # Limpiamos y dibujamos la gráfica actualizada
                plt.clf()  
                plt.axis([0, i+20, 0, 100])  # Fijamos los ejes
                plt.plot(eje_x, temperaturas, color='red', marker='o', label='Temperatura (°C)')
                plt.plot(eje_x, humedad, color='blue', marker='o', label='Humedad (%)')
                plt.draw()
                plt.pause(0.5)
                
                i = i + 1
   
            
            

    plt.show(block=True)

from tkinter import *

threadRecepcion = threading.Thread (target = grafica)
threadRecepcion.start()
def AClick ():
       mySerial.write("Inicio\n".encode('utf-8'))
def BClick ():
        mySerial.write("Parar\n".encode('utf-8'))
def CClick ():
        mySerial.write("Reanudar\n".encode('utf-8'))

window = Tk()
window.geometry("400x400")
window.rowconfigure(0, weight=1)
window.rowconfigure(1, weight=1)
window.rowconfigure(2, weight=1)
window.rowconfigure(3, weight=1)
window.columnconfigure(0, weight=1)
window.columnconfigure(1, weight=1)
window.columnconfigure(2, weight=1)


tituloLabel = Label(window, text = "Pulsa Iniciar para empezar la gráfica", font=("Courier", 10, "italic"))
tituloLabel.grid(row=0, column=2, padx=5, pady=5, sticky=N + S + E + W)

fraseEntry = Entry(window)
fraseEntry.grid(row=1, column=2, columnspan = 3, padx=5, pady=5, sticky=N + S + E + W)



AButton = Button(window, text="Iniciar", bg="#0AAE28", fg="white",command=AClick)
AButton.grid(row=1, column=0, padx=5, pady=5, sticky=N + S + E + W)
BButton = Button(window, text="Parar", bg="#BC0C0C", fg="white",command=BClick)
BButton.grid(row=2, column=0, padx=5, pady=5, sticky=N + S + E + W)
CButton = Button(window, text="Reanudar", bg='#818CF8', fg="white",command=CClick)
CButton.grid(row=3, column=0, padx=5, pady=5, sticky=N + S + E + W)

window.mainloop()
